# ── Server ───────────────────────────────────────────────────
PORT=3000
ENV=development          # development | production

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://scuderia:localdev@localhost:5432/scuderia?sslmode=disable

# ── Public URL ───────────────────────────────────────────────
PUBLIC_URL=              # https://scuderiast4ge.up.railway.app (Railway domain)

# ── Bold (Pasarela de pago) ──────────────────────────────────
BOLD_API_KEY=            # API key from bold.co dashboard
BOLD_WEBHOOK_SECRET=     # HMAC secret for webhook verification

# ── Telegram (Notificaciones al director) ────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Storage ──────────────────────────────────────────────────
UPLOADS_DIR=./uploads    # Directory for receipt uploads

# ── Admin (opcional) ─────────────────────────────────────────
ADMIN_TOKEN=             # Bearer token for admin endpoints
