# ══════════════════════════════════════════════════════════════════
#  Scudería St4ge — Variables de entorno
#  Copia este archivo a .env y llena los valores reales.
#  NUNCA subas .env al repositorio.
# ══════════════════════════════════════════════════════════════════

# ── Servidor ────────────────────────────────────────────────────
PORT=3000
# development  →  CORS solo en localhost, endpoints /dev/* activos, logs verbosos
# production   →  CORS abierto (*), endpoints /dev/* desactivados
ENV=development

# ── Base de datos (PostgreSQL) ───────────────────────────────────
# Formato: postgresql://usuario:password@host:5432/nombre_db?sslmode=disable
# Ejemplo local con Docker:  postgresql://scuderia:localdev@localhost:5432/scuderia?sslmode=disable
# Railway te da esta URL automáticamente en la variable DATABASE_URL del servicio.
DATABASE_URL=postgresql://scuderia:localdev@localhost:5432/scuderia?sslmode=disable

# ── URL pública ──────────────────────────────────────────────────
# Dominio donde vive el servidor en producción.
# Bold la usa para construir la redirect URL después del pago.
# En local puedes dejarla vacía o usar un túnel ngrok: https://abc123.ngrok.io
PUBLIC_URL=

# ── Bold (pasarela de pago colombiana) ──────────────────────────
# Consíguelas en https://bold.co → Developers → API Keys
# BOLD_API_KEY: clave para crear links de pago (empieza con "bold_pk_...")
# BOLD_WEBHOOK_SECRET: secreto HMAC para verificar webhooks entrantes
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=

# ── Telegram (notificaciones al director) ────────────────────────
# 1. Crea el bot con @BotFather → copia el token
# 2. Envía cualquier mensaje al bot desde tu cuenta
# 3. Visita: https://api.telegram.org/bot<TOKEN>/getUpdates
#    y busca "chat":{"id": <NÚMERO>} — ese es tu CHAT_ID
# En desarrollo puedes usar tu chat personal para recibir alertas de prueba.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Almacenamiento de comprobantes ───────────────────────────────
# Directorio donde se guardan los archivos de transferencia.
# En Railway se pierden al redeploy — usar S3/R2 en producción si se necesitan.
UPLOADS_DIR=./uploads

# ── Instagram Basic Display API ──────────────────────────────────
# Muestra las últimas publicaciones del perfil en el landing.
# Si está vacío, la sección muestra un fallback estático con link al perfil.
#
# Cómo obtener el token:
# 1. Crea una app en https://developers.facebook.com
# 2. Agrega el producto "Instagram Basic Display"
# 3. En "User Token Generator" agrega tu cuenta de Instagram y genera el token
# 4. Extiéndelo a long-lived (60 días) con:
#    curl -X GET "https://graph.instagram.com/access_token?grant_type=ig_exchange_token&client_id=<APP_ID>&client_secret=<APP_SECRET>&access_token=<SHORT_TOKEN>"
# 5. Para renovación automática considera un cron que llame al refresh endpoint.
INSTAGRAM_ACCESS_TOKEN=

# ── Admin ────────────────────────────────────────────────────────
# Bearer token para endpoints de diagnóstico (opcionales).
# Genera uno largo y aleatorio: openssl rand -hex 32
ADMIN_TOKEN=

# ══════════════════════════════════════════════════════════════════
#  ENDPOINTS DE DESARROLLO (solo activos cuando ENV=development)
# ══════════════════════════════════════════════════════════════════
#
#  Simular confirmación de pago para una inscripción específica:
#    curl -X POST http://localhost:3000/dev/inscripciones/<ID>/confirm
#
#  Simular rechazo de pago:
#    curl -X POST http://localhost:3000/dev/inscripciones/<ID>/reject
#
#  Flujo de prueba completo:
#  1. Levanta el servidor:   go build -o server.exe ./cmd/server/ && ./server.exe
#  2. Crea una inscripción via el formulario en http://localhost:5173/inscripcion
#  3. El formulario redirigirá a Bold (si hay BOLD_API_KEY) o irá directo a /success
#  4. Para simular que Bold confirmó el pago del usuario:
#       curl -X POST http://localhost:3000/dev/inscripciones/<ID>/confirm
#  5. El CallbackView en /callback?ref=<ID> se actualizará al estado "pagado"
#  6. Recibirás la notificación de Telegram con el monto real
#
#  Para probar sin Bold (método transferencia):
#  - Selecciona "Transferencia manual" en el formulario
#  - Sube cualquier imagen como comprobante
#  - El estado quedará "comprobante recibido, en validación"
