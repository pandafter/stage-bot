# ── Server ───────────────────────────────────────────────────
PORT=8080
ENV=development          # development | production

# ── Meta / Instagram ─────────────────────────────────────────
APP_ID=
APP_SECRET=
PAGE_ACCESS_TOKEN=       # Empieza con IGAA...
INSTAGRAM_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=    # Token personalizado para verificar webhook

# ── Anthropic (Claude AI) ────────────────────────────────────
ANTHROPIC_API_KEY=

# ── ElevenLabs (TTS/STT) ─────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── OpenAI (Whisper STT) ─────────────────────────────────────
OPENAI_API_KEY=

# ── Google Sheets (Knowledge Base) ────────────────────────────
GOOGLE_SHEET_ID=         # ID entre /d/ y /edit en la URL del sheet

# ── Public URL (ngrok en dev, dominio en prod) ────────────────
PUBLIC_URL=              # https://tu-dominio.com o URL de ngrok

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=data/bot.db

# ── Testing ───────────────────────────────────────────────────
TEST_SENDER_ID=          # Solo responde a este user en development
